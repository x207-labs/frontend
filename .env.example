# FE-059: email and Google sign-in through Privy. VITE_PRIVY_APP_ID is the App ID from the Privy dashboard; leave it empty to hide the option.
# FE-066: VITE_PRIVY_APP_CLIENT_ID is optional (set it only if the dashboard shows a Client ID). Never put the Privy App Secret in a VITE_* variable: it is a server credential.
VITE_PRIVY_APP_ID=
VITE_PRIVY_APP_CLIENT_ID=
# Base URL of the backend read API (backend repo, Backend API Spec).
VITE_X207_API_URL=http://localhost:8787
# circleId of the circle to display.
VITE_X207_CIRCLE=agents-main
# Read API polling interval in milliseconds (K-49).
VITE_X207_POLL_MS=5000
# true = use the Backend API Spec sample data without a backend.
VITE_X207_USE_FIXTURES=false
# NEAR network for the wallet: testnet or mainnet.
VITE_NEAR_NETWORK=testnet
# Circle contract account.
VITE_X207_CONTRACT_ID=x207-circle.testnet
# FE-110: USDT token (NEP-141) and NEAR Intents contract for stake, settle, and ft_withdraw. The app reads both from the circle contract (get_circle) first;
# these are the fallback. Empty = network default: testnet usdt.x207-deployer.testnet + intents.testnet, mainnet usdt.tether-token.near + intents.near.
# VITE_X207_USDT_TOKEN_ID=usdt.x207-deployer.testnet
# VITE_X207_INTENTS_ID=intents.testnet
# Base URL of the broker (access grants, one-time codes, transfers, orders). Default http://localhost:8788; a hosted build with no broker leaves it unset.
# VITE_X207_BROKER_URL=http://localhost:8788
# Explorer link prefix for NEAR Intents transactions. Default https://explorer.near-intents.org/transactions/
# VITE_X207_INTENTS_EXPLORER_URL=https://explorer.near-intents.org/transactions/
# NEAR RPC for contract views (Intents balance, intents, epoch pairs). Empty = FastNEAR matching VITE_NEAR_NETWORK.
# VITE_NEAR_RPC_URL=https://rpc.testnet.fastnear.com
# Extra origins the page may contact in the production build (CSP connect-src), comma-separated: the wallet origin from near-connect. Empty = only the API, broker, and RPC.
# VITE_X207_WALLET_ORIGINS=https://wallet.example
# off = build without the script and connection CSP (a temporary escape hatch if wallet login fails; do not use for releases).
# VITE_X207_CSP=off

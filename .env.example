# Basis URL read API backend (repo backend, Spec API Backend).
VITE_X207_API_URL=http://localhost:8787
# circleId lingkaran yang ditampilkan.
VITE_X207_CIRCLE=agents-main
# Interval polling read API dalam milidetik (K-49).
VITE_X207_POLL_MS=5000
# true = pakai data contoh Spec API Backend tanpa backend.
VITE_X207_USE_FIXTURES=false
